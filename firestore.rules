rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.dailyMessageCount is int && data.dailyMessageCount >= 0 &&
             data.quotaResetEpochDay is int &&
             (!('customApiKey' in data) || data.customApiKey == null || (data.customApiKey is string && data.customApiKey.size() <= 256));
    }

    function isValidProject(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('systemInstruction' in data) || (data.systemInstruction is string && data.systemInstruction.size() <= 5000)) &&
             (!('defaultModel' in data) || (data.defaultModel is string && data.defaultModel.size() <= 100)) &&
             (!('knowledgeContent' in data) || (data.knowledgeContent is string && data.knowledgeContent.size() <= 20000));
    }

    function isValidConversation(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.modelId is string && data.modelId.size() <= 100 &&
             data.isPinned is bool &&
             data.isArchived is bool &&
             (!('projectId' in data) || data.projectId == null || (data.projectId is string && data.projectId.size() <= 128)) &&
             (!('systemPrompt' in data) || (data.systemPrompt is string && data.systemPrompt.size() <= 5000)) &&
             (!('temperature' in data) || data.temperature is number) &&
             (!('maxOutputTokens' in data) || data.maxOutputTokens is int) &&
             (!('thinkingBudget' in data) || data.thinkingBudget is int) &&
             (!('toolWebSearch' in data) || data.toolWebSearch is bool) &&
             (!('toolCodeExecution' in data) || data.toolCodeExecution is bool) &&
             (!('toolImageGeneration' in data) || data.toolImageGeneration is bool) &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 10000));
    }

    function isValidMessage(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.conversationId is string && data.conversationId.size() <= 128 &&
             data.role in ['user', 'model', 'system'] &&
             data.content is string && data.content.size() <= 100000 &&
             (!('attachments' in data) || data.attachments is list) &&
             (!('groundingSources' in data) || data.groundingSources is list) &&
             (!('codeExecOutput' in data) || (data.codeExecOutput is string && data.codeExecOutput.size() <= 50000)) &&
             (!('generatedImageUrl' in data) || (data.generatedImageUrl is string && data.generatedImageUrl.size() <= 2000)) &&
             (!('tokenCount' in data) || data.tokenCount is int) &&
             (!('characterCount' in data) || data.characterCount is int);
    }

    // User Profile
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       incoming().userId == userId &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());
      allow update: if isOwner(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());
      allow delete: if isOwner(userId);

      // Projects subcollection
      match /projects/{projectId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(projectId) &&
                         incoming().userId == userId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidProject(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(projectId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidProject(incoming());
        allow delete: if isOwner(userId) && isValidId(projectId);
      }

      // Conversations subcollection
      match /conversations/{conversationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         incoming().userId == userId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidConversation(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidConversation(incoming());
        allow delete: if isOwner(userId) && isValidId(conversationId);

        // Messages subcollection
        match /messages/{messageId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) &&
                           isValidId(messageId) &&
                           incoming().userId == userId &&
                           incoming().conversationId == conversationId &&
                           incoming().createdAt is timestamp &&
                           incoming().createdAt <= request.time &&
                           isValidMessage(incoming());
          allow update: if isOwner(userId) &&
                           isValidId(messageId) &&
                           incoming().userId == existing().userId &&
                           incoming().conversationId == existing().conversationId &&
                           incoming().createdAt == existing().createdAt &&
                           isValidMessage(incoming());
          allow delete: if isOwner(userId) && isValidId(messageId);
        }
      }
    }
  }
}
